      "to": "committed",
      "tests": [
        "test_streaming.StreamingTests.test_tokens_arrive_before_history_commit"
      ]
    },
    {
      "id": "partial-failure",
      "title": "部分输出后失败",
      "given": "流已显示部分文本",
      "when": "后续模型流抛错",
      "then": "保留已显示事实，本轮不提交历史；既有成功历史不被失败模型修改",
