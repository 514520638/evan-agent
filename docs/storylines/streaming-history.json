    },
    {
      "id": "review-resume",
      "title": "人工审批后继续流式输出",
      "given": "模型请求长期写入审批",
      "when": "用户确认后恢复",
      "then": "审批前不写入，恢复后写入并继续显示最终文本，不向显示回调暴露 thinking 块",
      "from": "pending-review",
      "to": "committed",
      "tests": [
        "test_streaming.StreamingTests.test_stream_resumes_after_hitl_and_hides_thinking"
      ]
    }
