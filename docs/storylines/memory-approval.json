      "from": "pending-review",
      "to": "cancelled",
      "tests": [
        "test_memory_review.MemoryReviewTests.test_cancel_does_not_write_or_commit_history",
        "test_memory_review.MemoryReviewTests.test_update_waits_for_confirmation_and_keeps_original_on_cancel"
      ]
    },
