# MiniMax 开放平台 API Key，或 M Plan 订阅 Key
MINIMAX_API_KEY=your-minimax-key-here
# 国内站；国际站改为 https://api.minimax.io/anthropic
MINIMAX_BASE_URL=https://api.minimax.cn/anthropic
MODEL=MiniMax-M3.1-Flash
# MiniMax 内置搜索，复用上方凭据；每轮最多调用搜索工具两次。
WEB_SEARCH_ENABLED=true
# 国内接口直连，避免本机 HTTP(S)_PROXY 引起 TLS 握手失败
# 若已有 NO_PROXY 列表，请追加下面的域名
NO_PROXY=api.minimax.cn,api.minimaxi.com,127.0.0.1,localhost

# 短期上下文摘要：近似 Token 阈值与保留的近期消息数
SUMMARY_TRIGGER_TOKENS=6000
SUMMARY_KEEP_MESSAGES=10
# 每轮 agent.invoke 的上限；不包含摘要请求及 SDK 内部重试
MODEL_RUN_LIMIT=6
TOOL_RUN_LIMIT=8

# 本地博客与接口调试来源；生产部署改为实际域名，不使用 *
AGENT_ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081,http://127.0.0.1:8001,http://localhost:8001,https://evanlink.cn
# 本地 HTTP 为 false；HTTPS 部署时改为 true
AGENT_COOKIE_SECURE=false
# 同时执行的 HTTP 聊天数；2GB 共享生产服务器建议设为 1。
AGENT_MAX_CONCURRENT_REQUESTS=2

# 独立的 Embedding 服务；留空时明确回退 BM25，不复用 MiniMax 聊天凭据。
# 填写兼容 OpenAI 的 API 根地址（通常包含 /v1，不包含 /embeddings）。
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=8
# 余弦相似度阈值只是起始值，应使用真实问答集校准。
RAG_MIN_SIMILARITY=0.3
