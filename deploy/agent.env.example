# 仅为服务器配置模板，真实密钥手动填到 shared/agent.env，不打入镜像。
MINIMAX_API_KEY=REPLACE_ME
MINIMAX_BASE_URL=https://api.minimax.cn/anthropic
MODEL=MiniMax-M3.1-Flash
WEB_SEARCH_ENABLED=true
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=REPLACE_ME
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=8
RAG_MIN_SIMILARITY=0.3
AGENT_ALLOWED_ORIGINS=https://evanlink.cn,https://www.evanlink.cn
AGENT_COOKIE_SECURE=true
AGENT_MAX_CONCURRENT_REQUESTS=1
NO_PROXY=localhost,127.0.0.1,api.minimax.cn,api.siliconflow.cn
SUMMARY_TRIGGER_TOKENS=6000
SUMMARY_KEEP_MESSAGES=10
MODEL_RUN_LIMIT=6
TOOL_RUN_LIMIT=8

# 网页发布优先复用同域博客管理员登录 Cookie。以下仅供没有浏览器会话的入口选填。
BLOG_ADMIN_USERNAME=
BLOG_ADMIN_PASSWORD=

# 统一登录：Agent 服务端调用 Java 会话校验接口，不填博客密码。
BLOG_API_BASE_URL=https://evanlink.cn/api
# HTTP 默认仅使用博客统一登录；终端 evan-agent 的 /login 不受影响。
AGENT_ALLOW_LEGACY_WEB_LOGIN=false
